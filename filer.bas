1270  PRINT OP$F$: PRINT RD$F$
1280  FOR I = 1 TO LU: INPUT TU%(I): POKE M1,0: NEXT 
1290  FOR I = 1 TO OG: INPUT LO%(I),SO%(I),VO%(I): POKE M1,0: NEXT 
1300  FOR I = 1 TO NR: INPUT PT%(I): POKE M1,0: NEXT 
